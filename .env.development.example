# Copy to .env.development and fill in. Loaded by CRA when NODE_ENV=development
# (npm start, craco test). This file is gitignored.

# ── Backend selector ────────────────────────────────────────────────────
# Picks which API implementation the client uses. Set to "supabase" to
# point at a local Supabase stack (or the cloud project, once provisioned).
# Default stays "appwrite" while the cutover is in flight.
REACT_APP_BACKEND=appwrite

# ── Appwrite (legacy backend) ───────────────────────────────────────────
REACT_APP_ENDPOINT=https://fra.cloud.appwrite.io/v1
REACT_APP_PROJECT=your-dev-appwrite-project-id
REACT_APP_DATABASE_ID=thnkflist
REACT_APP_LISTS_COLLECTION_ID=lists
REACT_APP_ITEMS_COLLECTION_ID=items

REACT_APP_OAUTH_SUCCESS_URL=http://localhost:3000/lists
REACT_APP_OAUTH_FAILURE_URL=http://localhost:3000/login?error=oauth_failed

# ── Supabase (new backend) ──────────────────────────────────────────────
# For local dev these are the defaults printed by `supabase start`. The
# publishable key is the same on every machine that runs the local stack
# (it's a static dev key, not a secret). For the cloud project, get values
# from Project Settings → API.
REACT_APP_SUPABASE_URL=http://127.0.0.1:54321
REACT_APP_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
